# Sao chép thành .env.local (không commit)
VITE_API_BASE_URL=http://localhost:8080
# Web client ID của OAuth (project Firebase của nhóm) – không phải bí mật, dùng chung cho web, mobile, Identity
VITE_GOOGLE_CLIENT_ID=221888974127-ho8c6t3rqct6f7r5o2e8gott7i8lrd7s.apps.googleusercontent.com
# Firebase web app (FE-46: Analytics, Remote Config) – Firebase Console → Project settings → Your apps → Web.
# Mặc định đã có trong src/shared/config/env.ts (web app "EXE Team Matching Web"); chỉ điền khi muốn trỏ sang project khác.
# Đặt VITE_FIREBASE_API_KEY=off để tắt Analytics và Remote Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
