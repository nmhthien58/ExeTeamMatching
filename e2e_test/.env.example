# Chép thành .env (đã gitignore), không commit key.
# Key Gemini đặt ở máy chạy ARTEMIS: tệp .env trong thư mục clone của ARTEMIS, biến GEMINI_API_KEY.
ARTEMIS_BASE_URL=http://127.0.0.1:8000
ARTEMIS_TOKEN=
# Để trống thì dùng thiết bị đầu tiên ARTEMIS báo.
ARTEMIS_DEVICE_SERIAL=
# flash cho hồi quy, pro cho phiên khám phá.
ARTEMIS_PROFILE=flash
# Email tài khoản Google sinh viên test (SEED_STUDENT_EMAIL) – TC-17 chọn đúng tài khoản này khi đăng nhập lại.
TEST_ACCOUNT_EMAIL=
# Giá trị suggestions_max_items đang đặt trên Firebase Console, dùng cho TC-14.
EXPECTED_SUGGESTIONS_MAX=5
# Đường dẫn adb.exe nếu 'adb' không có trong PATH (ca TC-21 đọc Logcat).
ADB=adb
# Chạy cả ca cần điều kiện riêng, ví dụ: sinh viên đã có nhóm,cài mới app
ENABLED_PENDING=
