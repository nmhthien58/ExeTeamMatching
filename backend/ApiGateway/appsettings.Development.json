{
  "Jwt": {
    "Issuer": "exe-identity",
    "Audience": "exe-team-matching",
    "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-dev": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/dev/{**rest}"
        },
        "AuthorizationPolicy": "anonymous"
      }
    }
  }
}
