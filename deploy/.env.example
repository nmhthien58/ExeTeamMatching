# Sao chép thành deploy/.env rồi sửa. File .env không được commit.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Mật khẩu login role của từng service (mỗi service 1 database)
IDENTITY_DB_PASSWORD=identity_dev_pw
ACADEMIC_DB_PASSWORD=academic_dev_pw
TEAM_DB_PASSWORD=team_dev_pw
NOTIFICATION_DB_PASSWORD=notification_dev_pw
JOB_DB_PASSWORD=job_dev_pw
COLLAB_DB_PASSWORD=collab_dev_pw

# Tài khoản Admin đầu tiên: phải là email Google thật dùng để đăng nhập web
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Bộ môn EXE

# Lưu file workspace (BE-63): khóa S3 dev nằm ở deploy/seaweedfs/s3.json, Collab đọc qua ObjectStorage__AccessKey / __SecretKey
