# BE-85 – sao chép thành deploy/.env.prod trên VPS rồi sửa. KHÔNG commit file .env.prod.
# Sinh mật khẩu / khóa ngẫu nhiên: openssl rand -base64 32

# Tên miền (bản ghi A trỏ về IP VPS) và email nhận thông báo chứng chỉ Let's Encrypt
WEB_DOMAIN=exe.example.com
API_DOMAIN=api.exe.example.com
FILES_DOMAIN=files.exe.example.com
ACME_EMAIL=admin@example.com

# Postgres: mật khẩu superuser và login role của từng service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
ACADEMIC_DB_PASSWORD=
TEAM_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
JOB_DB_PASSWORD=
COLLAB_DB_PASSWORD=

# Admin đầu tiên (Bộ môn): email Google thật dùng để đăng nhập web
ADMIN_EMAIL=
ADMIN_NAME=Bộ môn EXE

# Khóa ký JWT, ít nhất 32 ký tự, khác khóa dev
JWT_SIGNING_KEY=

# Khóa S3 (SeaweedFS) – phải trùng với deploy/seaweedfs/s3.prod.json
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Web: Google OAuth client (thêm https://WEB_DOMAIN vào Authorized JavaScript origins) và Firebase web app (FE-46)
VITE_GOOGLE_CLIENT_ID=221888974127-ho8c6t3rqct6f7r5o2e8gott7i8lrd7s.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
